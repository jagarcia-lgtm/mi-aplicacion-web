{
  "name": "gestibrok",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run package:portable && npm run typecheck && vite build",
    "build:demo": "npm run package:portable && npm run typecheck && vite build --base=./",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "package:portable": "python3 scripts/package_portable.py",
    "pretest": "npm run package:portable"
  },
  "dependencies": {
    "lucide-react": "0.561.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.3",
    "vite": "8.3.4"
  }
}
